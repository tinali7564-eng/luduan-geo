# ==============================================================================
# Luduan GEO 2.1 Configuration
# Copy this file to .env and adjust your settings: cp .env.example .env
# ==============================================================================

NODE_ENV=production
PORT=8092
PUBLIC_URL=http://localhost:8092

# SQLite database directory (mounted as persistent volume in Docker)
DATA_DIR=./data

# Reverse proxy trust level (1 for Nginx, 2 for Cloudflare + Nginx)
TRUST_PROXY=1
TRUST_CF_HEADER=0

# ------------------------------------------------------------------------------
# Security & Authentication (Required)
# ------------------------------------------------------------------------------
# Generate a random 32-byte hex string: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret_key_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_on_launch

# ------------------------------------------------------------------------------
# LLM Providers (OpenAI-compatible endpoints: OpenAI, DeepSeek, Gemini, Groq, Ollama)
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL=gpt-4o-mini
LLM_CONCURRENCY=2
LLM_TIMEOUT_MS=90000

# Multi-Engine Tracking Matrix (JSON array of models to test and monitor against)
GEO_ENGINES='[
  {"id":"gpt4","label":"ChatGPT (GPT-4o)","model":"gpt-4o-mini"},
  {"id":"deepseek","label":"DeepSeek V3","model":"deepseek-chat"},
  {"id":"claude","label":"Claude 3.5 Sonnet","model":"claude-3-5-sonnet-20241022"},
  {"id":"gemini","label":"Gemini 2.5 Flash","model":"gemini-2.5-flash"}
]'

# ------------------------------------------------------------------------------
# Quotas & Rate Limits
# ------------------------------------------------------------------------------
GUEST_DAILY_QUOTA=5
FREE_DAILY_QUOTA=30
REGISTER_PER_IP_PER_DAY=5

# ------------------------------------------------------------------------------
# Optional: Email Notifications & Password Resets
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Luduan GEO Agent

# ------------------------------------------------------------------------------
# Optional: IndexNow & Search Engine Integrations
# ------------------------------------------------------------------------------
SCHEDULER_ENABLED=1
# INDEXNOW_KEY=your_indexnow_key
# GA_ID=
